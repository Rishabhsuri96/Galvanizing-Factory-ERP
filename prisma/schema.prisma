generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int              @id @default(autoincrement())
  name         String
  username     String           @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime         @default(now())
  isActive     Boolean          @default(true)
  activities   ActivityLog[]
  permissions  UserPermission[]
}

model Party {
  id            Int       @id @default(autoincrement())
  partyName     String
  gstNumber     String?
  address       String?
  phone         String?
  email         String?
  contactPerson String?
  createdAt     DateTime  @default(now())
  isActive      Boolean   @default(true)
  updatedAt     DateTime  @updatedAt
  challans      Challan[]
}

model Challan {
  id             Int           @id @default(autoincrement())
  challanNumber  String
  vehicleNumber  String?
  ewayNumber     String?
  receivedWeight Float
  receivedDate   DateTime      @default(now())
  partyId        Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  party          Party         @relation(fields: [partyId], references: [id])
  items          ChallanItem[]

  @@unique([partyId, challanNumber])
  @@index([partyId])
  @@index([receivedDate])
}

model ChallanItem {
  id                      Int                   @id @default(autoincrement())
  itemName                String
  receivedWeight          Float
  status                  ItemStatus            @default(RECEIVED)
  challanId               Int
  createdAt               DateTime              @default(now())
  itemCategoryId          Int
  sizeId Int
  size                    Size?                 @relation(fields: [sizeId], references: [id])
  pendingProductionWeight Float
  readyWeight             Float                 @default(0)
  updatedAt               DateTime              @updatedAt
  challan                 Challan               @relation(fields: [challanId], references: [id])
  itemCategory            ItemCategory?         @relation(fields: [itemCategoryId], references: [id])
  dispatchItems           DispatchItem[]
  productionItems         ProductionBatchItem[]

  @@index([challanId])
  @@index([itemCategoryId])
  @@index([itemCategoryId, sizeId])
  @@index([sizeId])
  @@index([status])
  @@index([readyWeight])
  @@index([pendingProductionWeight])
}

model Dispatch {
  id            Int            @id @default(autoincrement())
  vehicleNumber String?
  remarks       String?
  dispatchDate  DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         DispatchItem[]

  @@index([dispatchDate])
}

model DispatchItem {
  id            Int         @id @default(autoincrement())
  dispatchId    Int
  challanItemId Int
  createdAt     DateTime    @default(now())
  inputWeight   Float
  outputWeight  Float
  updatedAt     DateTime    @updatedAt
  challanItem   ChallanItem @relation(fields: [challanItemId], references: [id])
  dispatch      Dispatch    @relation(fields: [dispatchId], references: [id])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String
  createdAt DateTime @default(now())
  userId    Int
  details   String?
  user      User     @relation(fields: [userId], references: [id])
}

model Permission {
  id    Int              @id @default(autoincrement())
  code  String           @unique
  name  String
  users UserPermission[]
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, permissionId])
}

model Contractor {
  id        Int               @id @default(autoincrement())
  name      String
  phone     String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  address   String?
  remarks   String?
  updatedAt DateTime          @updatedAt
  rates     ContractorRate[]
  batches   ProductionBatch[]
}

model ContractorRate {
  id             Int  @id @default(autoincrement())
  contractorId   Int
  itemCategoryId Int
  sizeId         Int?

  ratePerKg     Float
  effectiveFrom DateTime
  isActive      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractor   Contractor   @relation(fields: [contractorId], references: [id])
  itemCategory ItemCategory @relation(fields: [itemCategoryId], references: [id])
  size          Size? @relation(fields: [sizeId], references: [id])
  productionItems ProductionBatchItem[]   

  @@unique([contractorId, itemCategoryId, sizeId, effectiveFrom])
  @@index([contractorId])
  @@index([itemCategoryId])
  @@index([sizeId])
  @@index([isActive])
  @@index([contractorId, itemCategoryId, sizeId])
  @@index([contractorId, itemCategoryId, sizeId, effectiveFrom])
  @@index([contractorId, itemCategoryId, sizeId, isActive])
  @@index([contractorId, itemCategoryId, isActive])
}

model Furnace {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  batches   ProductionBatch[]
}

model ProductionBatch {
  id           Int                   @id @default(autoincrement())
  batchNo      String                @unique
  processDate  DateTime              @default(now())
  contractorId Int
  furnaceId    Int
  remarks      String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  contractor   Contractor            @relation(fields: [contractorId], references: [id])
  furnace      Furnace               @relation(fields: [furnaceId], references: [id])
  items        ProductionBatchItem[]

  @@index([contractorId])
  @@index([furnaceId])
  @@index([processDate])
  shift Shift @default(DAY)
}
model ProductionBatchItem {
  id                Int             @id @default(autoincrement())

  productionBatchId Int
  challanItemId     Int

  // Production
  // Production
  inputWeight       Float
  outputWeight      Float?
  zincAddedWeight   Float?
  zincPercentage    Float?
  
  // Contractor
  contractorRate    Float
  contractorAmount  Float

  // Other
  remarks           String?
  completedAt       DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  challanItem       ChallanItem     @relation(fields: [challanItemId], references: [id])
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id])

  @@index([productionBatchId])
  @@index([challanItemId])
  @@index([productionBatchId, challanItemId])
  @@index([createdAt])
  @@index([completedAt])
  rateSourceId Int?
  rateSource   ContractorRate? @relation(fields: [rateSourceId], references: [id])
  @@unique([productionBatchId, challanItemId])
}
model ItemCategory {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  challanItems ChallanItem[]
  rates        ContractorRate[]
  sizes        Size[]
}

model Size {
  id Int @id @default(autoincrement())

  name String
  challanItems ChallanItem[]   
  itemCategoryId  Int
  itemCategory    ItemCategory     @relation(fields: [itemCategoryId], references: [id])
  contractorRates ContractorRate[]
  isActive        Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemCategoryId, name])
  @@index([itemCategoryId])
}

enum UserRole {
  OWNER
  MANAGER
  ACCOUNTANT
}

enum ItemStatus {
  RECEIVED
  PARTIALLY_PRODUCED
  READY
  PARTIALLY_DISPATCHED
  COMPLETED
}

enum Shift {
  DAY
  NIGHT
}
model ZincInventory {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  type        ZincTransactionType
  weight      Float
  ratePerKg   Float?
  supplier    String?
  remarks     String?
  createdAt   DateTime @default(now())
}

enum ZincTransactionType {
  PURCHASE
  ADJUSTMENT
}
enum ChemicalType {
  IN
  OUT
}
model ChemicalInventory {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  chemical    String
  weight      Float
  supplier    String?
  remarks     String?
  createdAt   DateTime @default(now())
  type        ChemicalType
}
