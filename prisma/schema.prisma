generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  MANAGER
  ACCOUNTANT
}

enum ItemStatus {
  RECEIVED
  STORED
  IN_PRODUCTION
  READY
  PARTIALLY_DISPATCHED
  COMPLETED
}

enum Shift {
  DAY
  NIGHT
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())

  permissions UserPermission[]
  activities  ActivityLog[]
}

model Party {
  id Int @id @default(autoincrement())

  partyName     String
  gstNumber     String?
  address       String?
  phone         String?
  email         String?
  contactPerson String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  challans Challan[]
}

model Challan {
  id Int @id @default(autoincrement())

  challanNumber String
  vehicleNumber String?
  ewayNumber    String?

  receivedWeight Float

  receivedDate DateTime @default(now())

  partyId Int
  party   Party @relation(fields: [partyId], references: [id])

  items ChallanItem[]

  createdAt DateTime @default(now())

  @@unique([partyId, challanNumber])
  @@index([partyId])
  @@index([receivedDate])
}

model ChallanItem {
  id Int @id @default(autoincrement())

  itemName String

  receivedWeight Float
  currentWeight  Float

  itemCategoryId Int
  size           String?

  status ItemStatus @default(RECEIVED)

  challanId Int
  challan   Challan @relation(fields: [challanId], references: [id])

  itemCategory ItemCategory @relation(fields: [itemCategoryId], references: [id])

  dispatchItems   DispatchItem[]
  productionItems ProductionBatchItem[]

  createdAt DateTime @default(now())

  @@index([challanId])
  @@index([itemCategoryId])
  @@index([itemCategoryId, size])
  @@index([status])
}

model Dispatch {
  id Int @id @default(autoincrement())

  vehicleNumber String?
  remarks       String?

  dispatchDate DateTime @default(now())

  items DispatchItem[]

  createdAt DateTime @default(now())

  @@index([dispatchDate])
}

model DispatchItem {
  id Int @id @default(autoincrement())

  dispatchedWeight Float

  dispatchId Int
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id])

  challanItemId Int
  challanItem   ChallanItem @relation(fields: [challanItemId], references: [id])

  createdAt DateTime @default(now())
}

model ActivityLog {
  id Int @id @default(autoincrement())

  action  String
  details String?

  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])
}

model Permission {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  users UserPermission[]
}

model UserPermission {
  id Int @id @default(autoincrement())

  userId       Int
  permissionId Int

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([userId, permissionId])
}

model Contractor {
  id Int @id @default(autoincrement())

  name    String
  phone   String?
  address String?
  remarks String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  rates   ContractorRate[]
  batches ProductionBatch[]
}

model ContractorRate {
  id Int @id @default(autoincrement())

  contractorId   Int
  itemCategoryId Int
  size           String?

  ratePerKg Float

  effectiveFrom DateTime

  contractor Contractor @relation(fields: [contractorId], references: [id])

  itemCategory ItemCategory @relation(fields: [itemCategoryId], references: [id])

  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  @@unique([contractorId, itemCategoryId, size, effectiveFrom])
  @@index([contractorId])
  @@index([itemCategoryId])
  @@index([contractorId, itemCategoryId, size])
  @@index([contractorId, itemCategoryId, size, effectiveFrom])
  @@index([isActive])
}

model Furnace {
  id Int @id @default(autoincrement())

  name String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  batches ProductionBatch[]
}

model ProductionBatch {
  id Int @id @default(autoincrement())

  batchNo String @unique

  processDate DateTime @default(now())

  contractorId Int
  furnaceId    Int
  shift        Shift

  remarks String?

  contractor Contractor @relation(fields: [contractorId], references: [id])

  furnace Furnace @relation(fields: [furnaceId], references: [id])

  items ProductionBatchItem[]

  createdAt DateTime @default(now())

  @@index([contractorId])
  @@index([furnaceId])
  @@index([processDate])
}

model ProductionBatchItem {
  id Int @id @default(autoincrement())

  productionBatchId Int
  challanItemId     Int

  processedWeight  Float
  outputWeight     Float
  zincAddedWeight  Float
  zincPercentage   Float
  contractorRate   Float
  contractorAmount Float
  remarks          String?

  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id])

  challanItem ChallanItem @relation(fields: [challanItemId], references: [id])

  createdAt DateTime @default(now())

  @@index([productionBatchId])
  @@index([challanItemId])
  @@index([productionBatchId, challanItemId])
  @@index([createdAt])
}

model ItemCategory {
  id Int @id @default(autoincrement())

  name String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  rates        ContractorRate[]
  challanItems ChallanItem[]
}
